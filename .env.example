# Clerk publishable key (public client-side configuration)
# Copy this file to .env and replace the placeholder with your Clerk key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# PostHog public client-side configuration
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host
